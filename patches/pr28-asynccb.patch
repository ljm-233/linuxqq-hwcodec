     return orig(self);
 }
 
+/* ---------- 异步回调变体（QQ_NVENC_ASYNCCB=1） ---------- */
+
+/* 补发上一帧的回调 —— 必须在「上一次 DoEncode 已经返回」之后调用 */
+static void async_flush(struct wrapped *w)
+{
+    void *pk;
+
+    if (!w->pend)
+        return;
+    w->pend = 0;
+    if (!w->have_cb || !w->pend_shadow) {
+        LOG("NVENC: [ASYNCCB] 有挂起帧但没有回调或影子 packet，丢弃");
+        return;
+    }
+    pk = w->pend_shadow;
+    LOG("NVENC: [ASYNCCB] 补发上一帧回调 idx=%u len=%u",
+        get32((char *)pk + PKT_OFF_IDX), get32((char *)pk + PKT_OFF_LEN));
+    ((pkt_cb_fn)w->cb0)(w->cb_ctx, &pk, w->cb1);
+    LOG("NVENC: [ASYNCCB] 补发回调已返回");
+}
+
+/* 把这一帧的码流复制下来、装进影子 packet，等下一次进入时补发 */
+static int async_prepare(struct wrapped *w, void *src_pkt, uint32_t idx, uint32_t qp,
+                         uint32_t sz, const void *data)
+{
+    if (!w->pend_shadow) {
+        w->pend_shadow = calloc(1, SHADOW_SIZE);
+        if (!w->pend_shadow)
+            return -1;
+    }
+    if (w->cb_cap < sz) {
+        void *n = realloc(w->cb_copy, sz);
+
+        if (!n)
+            return -1;
+        w->cb_copy = n;
+        w->cb_cap = sz;
+    }
+    memcpy(w->cb_copy, data, sz);
+    /* 影子 packet：先照抄调用方那份（保留它填过的其它字段），再写我们这四个 */
+    if (src_pkt)
+        memcpy(w->pend_shadow, src_pkt, SHADOW_SIZE);
+    put32((char *)w->pend_shadow + PKT_OFF_IDX, idx);
+    put32((char *)w->pend_shadow + PKT_OFF_QP, qp);
+    put32((char *)w->pend_shadow + PKT_OFF_LEN, sz);
+    put64((char *)w->pend_shadow + PKT_OFF_DATA, w->cb_copy);
+    w->pend = 1;
+    return 0;
+}
+
