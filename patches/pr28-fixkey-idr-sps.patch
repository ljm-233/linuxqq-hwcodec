+/* FIXKEY：从一帧 Annex-B 码流里抠出 SPS(7)+PPS(8) 并缓存（含起始码）。
+ * 返回 1 = 本次成功缓存；0 = 这帧没有参数集 / 已有缓存 / 抠不出来。 */
+static int fixkey_grab_ps(struct wrapped *w, const unsigned char *bs, uint32_t len)
+{
+    uint32_t i = 0, ps_start = 0, ps_end = 0, sz;
+    int have_sps = 0, have_pps = 0;
+
+    if (w->sps_pps_len || !bs || len < 8)
+        return 0;
+    while (i + 4 <= len) {
+        uint32_t sc = 0, nal;
+        if (bs[i] == 0 && bs[i + 1] == 0 && bs[i + 2] == 1)
+            sc = 3;
+        else if (bs[i] == 0 && bs[i + 1] == 0 && bs[i + 2] == 0 && bs[i + 3] == 1)
+            sc = 4;
+        if (!sc) { i++; continue; }
+        nal = bs[i + sc] & 0x1f;
+        if (nal == 7 && !have_sps) { ps_start = i; have_sps = 1; i += sc; continue; }
+        if (nal == 8 && have_sps && !have_pps) { have_pps = 1; i += sc; continue; }
+        if (have_pps) { ps_end = i; break; }
+        i += sc;
+    }
+    if (have_pps && ps_end == 0)
+        ps_end = len;
+    if (!have_sps || !have_pps || ps_end <= ps_start)
+        return 0;
+    sz = ps_end - ps_start;
+    if (sz < 8 || sz > 4096)
+        return 0;
+    w->sps_pps = (unsigned char *)malloc(sz);
+    if (!w->sps_pps)
+        return 0;
+    memcpy(w->sps_pps, bs + ps_start, sz);
+    w->sps_pps_len = sz;
+    return 1;
+}
+
+/* FIXKEY：把 SPS/PPS 前缀 + 码流副本拼进我们自己的缓冲。
+ * 返回 0 成功：指针与长度改指向 w->fixbuf；-1 失败。 */
+static int fixkey_build(struct wrapped *w, const unsigned char *bs, uint32_t bs_len,
+                        void **ptr, uint32_t *sz)
+{
+    uint32_t i, pre, need;
+    int has_ps = 0;
+
+    /* 扫 Annex-B 起始码，看码流里是否已带参数集（4 字节或 3 字节起始码） */
+    for (i = 0; i + 3 < bs_len; ) {
+        if (bs[i] == 0 && bs[i + 1] == 0 && bs[i + 2] == 1) {
+            unsigned t = bs[i + 3] & 0x1f;
+            if (t == 7 || t == 8) {
+                has_ps = 1;
+                break;
+            }
+            i += 3;
+            continue;
+        }
+        i++;
+    }
+    pre = has_ps ? 0 : w->sps_pps_len;
+    need = pre + bs_len;
+    if (need > w->fix_cap) {
+        unsigned char *nb = (unsigned char *)realloc(w->fixbuf, need + 1024);
+        if (!nb)
+            return -1;
+        w->fixbuf = nb;
+        w->fix_cap = need + 1024;
+    }
+    if (pre)
+        memcpy(w->fixbuf, w->sps_pps, pre);
+    memcpy(w->fixbuf + pre, bs, bs_len);
+    *ptr = w->fixbuf;
+    *sz = need;
     return 0;
 }
 
