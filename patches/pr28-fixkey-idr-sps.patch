+    put32((char *)w->pend_shadow + PKT_OFF_IDX, idx);
+    put32((char *)w->pend_shadow + PKT_OFF_QP, qp);
+    put32((char *)w->pend_shadow + PKT_OFF_LEN, sz);
+    put64((char *)w->pend_shadow + PKT_OFF_DATA, w->cb_copy);
+    w->pend = 1;
+    return 0;
+}
