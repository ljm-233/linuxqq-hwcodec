+/* 码流首部分析：判断封装（Annex-B vs AVCC）、有没有 SPS/PPS、profile 档位。
+ * 只读、只在 QQ_NVENC_HEXDUMP=1 时调用。原实现的缓冲是复用的，
+ * 所以调用方必须【在回调里立刻】把指针交进来，不能延后。 */
+static void bs_analyze(const char *tag, const void *p, uint32_t n)
+{
+    const unsigned char *b = p;
+    char hex[3 * 16 + 1];
+    size_t j, k;
+    int annexb = 0, avcc = 0, sps = 0, pps = 0, idr = 0, nonidr = 0;
+    int profile = -1;
+
+    if (!p || n < 4)
+        return;
+    k = (n > 16) ? 16 : n;
+    for (j = 0; j < k; ++j)
+        sprintf(hex + 3 * j, "%02x ", b[j]);
+    hex[3 * k] = '\0';
+    LOG("%s 码流 len=%u 首 %zu 字节: %s", tag, n, k, hex);
+
+    /* 封装判定 */
+    if (b[0] == 0 && b[1] == 0 && b[2] == 0 && b[3] == 1)
+        annexb = 4;
+    else if (b[0] == 0 && b[1] == 0 && b[2] == 1)
+        annexb = 3;
+    else {
+        uint32_t v = ((uint32_t)b[0] << 24) | ((uint32_t)b[1] << 16) |
+                     ((uint32_t)b[2] << 8) | (uint32_t)b[3];
+        if (v > 0 && v <= n)
+            avcc = 1;                       /* 4 字节大端长度前缀 = AVCC */
+    }
+
+    /* AVCC：按长度前缀走一遍，否则看不到 SPS/PPS（它们是长度前缀而不是起始码） */
+    if (avcc) {
+        uint32_t off = 0, lim2 = (n < 64) ? n : 64;
+        while (off + 4 <= lim2) {
+            uint32_t l = ((uint32_t)b[off] << 24) | ((uint32_t)b[off + 1] << 16) |
+                         ((uint32_t)b[off + 2] << 8) | (uint32_t)b[off + 3];
+            unsigned char nal;
+            if (!l || off + 4 + l > n)
+                break;
+            nal = b[off + 4] & 0x1f;
+            if (nal == 7) {
+                sps = 1;
+                if (profile < 0)
+                    profile = b[off + 5];
+            } else if (nal == 8) {
+                pps = 1;
+            } else if (nal == 5) {
+                idr = 1;
+            } else if (nal == 1) {
+                nonidr = 1;
+            }
+            off += 4 + l;
+        }
+    }
+
+    /* 扫前 64 字节里的 NAL（只做粗略识别，够判读用） */
+    if (!avcc) {
+        uint32_t lim = (n < 64) ? n : 64;
+        uint32_t i2;
+        for (i2 = 0; i2 + 4 < lim; ++i2) {
+            int sc = 0;
+            if (b[i2] == 0 && b[i2 + 1] == 0 && b[i2 + 2] == 0 && b[i2 + 3] == 1)
+                sc = 4;
+            else if (b[i2] == 0 && b[i2 + 1] == 0 && b[i2 + 2] == 1)
+                sc = 3;
+            if (!sc || i2 + sc >= lim)
+                continue;
+            {
+                unsigned char nal = b[i2 + sc] & 0x1f;
+                if (nal == 7) {
+                    sps = 1;
+                    if (i2 + sc + 1 < lim && profile < 0)
+                        profile = b[i2 + sc + 1];
+                } else if (nal == 8) {
+                    pps = 1;
+                } else if (nal == 5) {
+                    idr = 1;
+                } else if (nal == 1) {
+                    nonidr = 1;
+                }
+            }
+        }
+    }
+
+    LOG("%s 封装=%s%s SPS=%s PPS=%s IDR=%s 非IDR=%s profile=%s",
+        tag,
+        annexb == 4 ? "Annex-B(4字节起始码)" : annexb == 3 ? "Annex-B(3字节起始码)" : "",
+        avcc ? "AVCC(4字节长度前缀)" : "",
+        sps ? "有" : "无", pps ? "有" : "无",
+        idr ? "有" : "无", nonidr ? "有" : "无",
+        profile < 0 ? "?" : profile == 0x42 ? "0x42 Baseline"
+                   : profile == 0x4d ? "0x4D Main"
+                   : profile == 0x64 ? "0x64 High" : "其它");
+}
