 /* ---------- 环境开关 ---------- */
@@ -271,7 +273,24 @@ struct wrapped {
     /* SetCodecCallback 拿到的（原始回调，不是我们的转发壳） */
     int have_cb;
     void *cb_ctx, *cb0, *cb1;
+
+    /* 异步回调变体（QQ_NVENC_ASYNCCB=1）：
+     * 原实现是 DoEncode 返回之后由编码线程回调，且递下去的是它自己的 packet；
+     * 这里把回调推迟到下一次 our_encode 进入时补发（= 上一次 DoEncode 返回之后），
+     * 并给下游一个我们自己的影子 packet + 码流副本（NVENC 的输出缓冲在
+     * nvEncUnlockBitstream 之后不保证还有效，必须复制）。 */
+    int pend;                     /* 有一帧待补发 */
+    void *pend_shadow;            /* 影子 packet（跨调用有效） */
+    void *cb_copy;                /* 码流副本 */
+    uint32_t cb_cap;
 };
+
+#define SHADOW_SIZE 0x80u         /* 与探针 hexdump 的 packet 长度一致 */
+
+/* 前置声明：our_uninit 里也要用来补发最后一帧 */
+static void async_flush(struct wrapped *w);
+static int async_prepare(struct wrapped *w, void *src_pkt, uint32_t idx, uint32_t qp,
