     if (!is_ppapi_process())
         return;
 
-    LOG("ppapi 进程，等待 AVSDK 加载（QQ_NVENC=1, ACTIVE=%d）", nv_active);
+    LOG("ppapi 进程，等待 AVSDK 加载（QQ_NVENC=1, ACTIVE=%d, ASYNCCB=%d）",
