+                    LOG("NVENC: [ASYNCCB] 影子 packet/码流副本分配失败，本帧回落原实现");
+                    w->nv_dead = 1;
+                    nv_close(w);
+                } else {
+                    if (w->encode_calls <= 4)
+                        LOG("NVENC: [ASYNCCB] 延迟回调 idx=%lld %u 字节 qp=%u（本次 DoEncode 直接返回，下次进入时补发）",
+                            idx, sz, qp);
+                    return 0;
+                }
+            } else {
+                ((pkt_cb_fn)w->cb0)(w->cb_ctx, &pk, w->cb1);
+                if (w->encode_calls <= 4)
+                    LOG("NVENC: 回调已返回");
+                return 0;
+            }
         }
         LOG("NVENC: 本帧失败，之后回落原实现");
         w->nv_dead = 1;
@@ -872,10 +966,12 @@ static void qq_nvenc_init(void)
         return;
     probe_dump = flag_on("QQ_NVENC_PROBE_DUMP", 1);
