 /* 把 VideoFrame(I420) 拷进 NVENC 输入缓冲，编码一帧；码流在【锁定期间】交给 emit 回调，
  * 由它去填 VideoPacket 并通知 AVSDK。失败返回 -1（调用方回落原实现）。
  * emit 返回非 0 视为交付失败。 */
+/* ---------- FIXKEY：615 驱动兜底（QQ_NVENC_FIXKEY=1 开启，默认关） ---------- */
+
+static int fx_on;                 /* QQ_NVENC_FIXKEY */
+static int fx_interval = 60;      /* QQ_NVENC_FIXKEY_INTERVAL */
+static int fx_reopen = 1;         /* QQ_NVENC_FIXKEY_REOPEN */
+
+/* 遍历 Annex-B 码流里的 NAL（3/4 字节起始码都可），返回 1 表示取到一个 */
+static int fx_next_nal(const uint8_t *p, uint32_t n, uint32_t *pos,
+                       uint32_t *start, uint32_t *len, int *type)
+{
+    uint32_t i = *pos, k, sc;
+
+    while (i + 3 <= n) {
+        if (p[i] == 0 && p[i + 1] == 0) {
+            if (p[i + 2] == 1) { k = i; sc = 3; break; }
+            if (i + 4 <= n && p[i + 2] == 0 && p[i + 3] == 1) { k = i; sc = 4; break; }
+        }
+        ++i;
+    }
+    if (i + 3 > n)
+        return 0;
+    if (k + sc >= n)
+        return 0;
+    *start = k;
+    *type = p[k + sc] & 0x1f;
+    /* 找下一个起始码作为本 NAL 的结束 */
+    i = k + sc + 1;
+    while (i + 3 <= n) {
+        if (p[i] == 0 && p[i + 1] == 0 &&
+            (p[i + 2] == 1 || (i + 4 <= n && p[i + 2] == 0 && p[i + 3] == 1)))
+            break;
+        ++i;
+    }
+    *len = (i + 3 <= n ? i : n) - k;
+    *pos = (i + 3 <= n ? i : n);
+    return 1;
+}
+
+/* 从码流里抠 SPS(7)+PPS(8)，连起始码一起存进 w->fx_ps */
+static int fx_scan_ps(struct wrapped *w, const uint8_t *p, uint32_t n)
+{
+    uint32_t pos = 0, st = 0, ln = 0, sp = 0, sl = 0, pp = 0, pl = 0;
+    int type = 0;
+
+    while (fx_next_nal(p, n, &pos, &st, &ln, &type)) {
+        if (type == 7 && !sl) { sp = st; sl = ln; }
+        else if (type == 8 && !pl) { pp = st; pl = ln; }
+        if (sl && pl)
+            break;
+    }
+    if (!sl || !pl)
+        return 0;
+    if (w->fx_ps)
+        free(w->fx_ps);
+    w->fx_ps_len = sl + pl;
+    w->fx_ps = malloc(w->fx_ps_len);
+    if (!w->fx_ps) {
+        w->fx_ps_len = 0;
+        return 0;
+    }
+    memcpy(w->fx_ps, p + sp, sl);
+    memcpy(w->fx_ps + sl, p + pp, pl);
+    return 1;
+}
+
+/* 拿参数集：先问驱动（必须在编码之后再问，615 上初始化后立刻问取不到），拿不到就从码流抠 */
+static void fx_grab_ps(struct wrapped *w, const uint8_t *bs, uint32_t bs_len)
+{
+    if (w->fx_ps_len)
+        return;
+    if (nvfl.nvEncGetSequenceParams && w->session) {
+        NV_ENC_SEQUENCE_PARAM_PAYLOAD sp;
+        uint8_t buf[1024];
+        uint32_t outsz = 0;
+        memset(&sp, 0, sizeof sp);
+        sp.version = NV_ENC_SEQUENCE_PARAM_PAYLOAD_VER;
+        sp.inBufferSize = (uint32_t)sizeof buf;
+        sp.spsppsBuffer = buf;
+        sp.outSPSPPSPayloadSize = &outsz;
+        if (nvfl.nvEncGetSequenceParams(w->session, &sp) == NV_ENC_SUCCESS && outsz) {
+            uint32_t k = outsz > sizeof buf ? (uint32_t)sizeof buf : outsz;
+            if (fx_scan_ps(w, buf, k)) {
+                LOG("NVENC: [FIXKEY] 从驱动取到参数集 %u 字节", w->fx_ps_len);
+                return;
+            }
+        }
+    }
+    if (bs && bs_len && fx_scan_ps(w, bs, bs_len))
+        LOG("NVENC: [FIXKEY] 从码流抠到参数集 %u 字节", w->fx_ps_len);
+}
+
+/* 码流第一个 NAL 就是 SPS 时说明已带参数集，不要重复补 */
+static int fx_has_ps(const uint8_t *p, uint32_t n)
+{
+    uint32_t pos = 0, st = 0, ln = 0;
+    int type = 0;
+
+    return fx_next_nal(p, n, &pos, &st, &ln, &type) && type == 7;
+}
+
+/* 把 w->fx_ps 拼在码流前（复制进自己的缓冲：驱动那块解锁即失效） */
+static int fx_prefix(struct wrapped *w, const void *data, uint32_t size,
+                     const void **out, uint32_t *out_size)
+{
+    uint32_t need = w->fx_ps_len + size;
+
+    if (need > w->fx_pkt_cap) {
+        uint8_t *nb = realloc(w->fx_pkt, need);
+        if (!nb)
+            return 0;
+        w->fx_pkt = nb;
+        w->fx_pkt_cap = need;
+    }
+    memcpy(w->fx_pkt, w->fx_ps, w->fx_ps_len);
+    memcpy(w->fx_pkt + w->fx_ps_len, data, size);
+    *out = w->fx_pkt;
+    *out_size = need;
+    return 1;
+}
+
+static void fx_free(struct wrapped *w)
+{
+    free(w->fx_ps);
+    free(w->fx_pkt);
+    w->fx_ps = NULL;
+    w->fx_pkt = NULL;
+    w->fx_ps_len = w->fx_pkt_cap = 0;
+}
