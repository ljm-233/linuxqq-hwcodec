#!/bin/bash
# 用探针启动 QQ：把 libhwprobe.so 追加进 LD_PRELOAD，然后交给 linuxqq-wayland-fix。
#
# 为什么这样叠加是安全的：linuxqq-wayland-fix 的启动器是
#   export LD_PRELOAD="$preload${LD_PRELOAD:+:$LD_PRELOAD}"
# 也就是**前置**它自己的库并保留已有的 LD_PRELOAD —— 所以我们先设，它不会覆盖。
set -uo pipefail
here=$(cd "$(dirname "$0")" && pwd)
so="$here/libhwprobe.so"

[ -f "$so" ] || { echo "还没编译，先跑：$here/build.sh" >&2; exit 1; }
command -v linuxqq-wayland-fix >/dev/null || { echo "找不到 linuxqq-wayland-fix（先装 linuxqq-wayland-fix）" >&2; exit 1; }

# 辅助命令（date/pgrep/grep/head/pw-dump/seq/sleep）一律摘掉 LD_PRELOAD 再跑。
# 2026-10-03 实测：不摘的话每条辅助命令都会继承探针、各自在日志里写一份汇总块 ——
# 一份 3768 行 / 232 个进程块的日志，翻半天有效数据为零。
# LD_PRELOAD= （空值）时动态加载器不会预加载任何库，比再 fork 一个 env 更干净。
nopre() { LD_PRELOAD= HWPROBE_LOG= HWPROBE_VTABLE= HWPROBE_ALL= "$@"; }

logdir="${XDG_CACHE_HOME:-$HOME/.cache}/linuxqq-hwcodec"
mkdir -p "$logdir"
log="$logdir/probe-$(nopre date +%Y%m%d-%H%M%S).log"

export HWPROBE_LOG="$log"
# 画面正常靠它（2026-10-03 实测：--use-angle=vulkan 会让接收画面缩成小图）
export QQ_WAYLAND_FIX_ANGLE="${QQ_WAYLAND_FIX_ANGLE:-off}"
# 追加而不是覆盖
export LD_PRELOAD="$so${LD_PRELOAD:+:$LD_PRELOAD}"

{
	echo "=== 探针启动 $(nopre date '+%F %T')"
	echo "    探针库: $so"
	echo "    QQ_WAYLAND_FIX_ANGLE=$QQ_WAYLAND_FIX_ANGLE"
	echo "    LD_PRELOAD=$LD_PRELOAD"
	echo "    HWPROBE_VTABLE=${HWPROBE_VTABLE:-（未设，COM 层不挂钩）}"
} >>"$log"

append_log() {   # 每行都带时间戳写进日志
	local ts l
	ts=$(nopre date '+%F %T')
	for l in "$@"; do printf '%s %s\n' "$ts" "$l" >>"$HWPROBE_LOG" 2>/dev/null; done
}

# ---------------------------------------------------------------------------
# 自检：确认探针到底进了哪个进程、共享有没有真的跑起来
#   （2026-10-03 的教训：日志里几十个进程块，没有自检就分不清收帧进程有没有被覆盖）
# 输出两行：状态行 + 结论行（结论行以「自检结论：」开头，便于 grep 与机器判读）
selfcheck_lines() {
	local p pp fix bc share main mainpp bcprocs m c

	p=$(nopre pgrep -f 'type=ppapi' 2>/dev/null | nopre head -1)

	# 主进程：cmdline 里没有 --type= 的那个 qq
	main=""
	for m in $(nopre pgrep -x qq 2>/dev/null); do
		c=$(nopre tr '\0' ' ' < "/proc/$m/cmdline" 2>/dev/null)
		case "$c" in *--type=*) ;; *) main="$m"; break ;; esac
	done
	mainpp=无主进程
	if [ -n "$main" ]; then
		if nopre grep -qs 'libhwprobe\.so' "/proc/$main/maps"; then mainpp=在; else mainpp=不在; fi
	fi

	# 所有加载了 broadcast-core 的 qq 进程（别假定一定是 ppapi）
	bcprocs=""
	for m in $(nopre pgrep -x qq 2>/dev/null); do
		nopre grep -qs 'broadcast-core\.so' "/proc/$m/maps" 2>/dev/null && bcprocs="$bcprocs $m"
	done
	[ -n "$bcprocs" ] || bcprocs="（暂无）"

	if [ -z "$p" ]; then
		printf '自检：没有 --type=ppapi 收帧进程（QQ 未启动，或者还没开过共享）；主进程(pid=%s) 探针=%s；加载 broadcast-core 的进程:%s\n' \
			"${main:-无}" "$mainpp" "$bcprocs"
		printf '自检结论：失败 —— 没有收帧进程。请先完全退出 QQ（含托盘，pgrep -x qq 应为空），再用本启动器启动，然后开一次共享。\n'
		return 1
	fi

	pp=不在; fix=不在; bc=不在
	nopre grep -qs 'libhwprobe\.so' "/proc/$p/maps" && pp=在
	nopre grep -qs 'libqq-wl-portal\.so' "/proc/$p/maps" && fix=在
	nopre grep -qs 'broadcast-core\.so' "/proc/$p/maps" && bc=在
	share=未开始
	nopre pw-dump 2>/dev/null | nopre grep -q 'Stream/Output/Video' && share=进行中

	printf '自检：ppapi(pid=%s) 探针=%s 修复库=%s broadcast-core=%s 共享=%s | 主进程(pid=%s) 探针=%s | 加载 broadcast-core 的进程:%s\n' \
		"$p" "$pp" "$fix" "$bc" "$share" "${main:-无}" "$mainpp" "$bcprocs"

	if [ "$pp" = 不在 ]; then
		printf '自检结论：失败 —— 探针不在收帧进程（它属于另一个 QQ 实例？先完全退出 QQ 再启动）\n'
		return 1
	fi
	if [ "$mainpp" = 不在 ]; then
		printf '自检结论：失败 —— 探针不在主进程（COM 对象很可能是在主进程里创建、再被 fork 出来的子进程继承；主进程没探针就看不到编码器选择）\n'
		return 1
	fi
	if [ "$fix" = 不在 ]; then
		printf '自检结论：失败 —— 修复库不在收帧进程里（这样共享会失败；确认走的是 linuxqq-wayland-fix）\n'
		return 1
	fi
	if [ "$bc" = 不在 ]; then
		if [ "$share" = 进行中 ]; then
			printf '自检结论：等待 —— 正在共享，但 ppapi 里还没加载 broadcast-core（看上面"加载 broadcast-core 的进程"那一栏，编码可能在别的进程里）\n'
		else
			printf '自检结论：等待 —— 探针已就位，但共享还没开始（开一次共享后再跑 --selfcheck-once）\n'
		fi
		return 1
	fi
	if [ "$share" != 进行中 ]; then
		printf '自检结论：等待 —— 探针与 broadcast-core 都在，但共享未开始（开一次共享后再跑 --selfcheck-once）\n'
		return 1
	fi
	printf '自检结论：可以采集 —— 探针=在 修复库=在 broadcast-core=在 共享=进行中\n'
	return 0
}

selfcheck_once() {   # 打印到终端 + 写进日志（这样结论不会只活在 stdout 里）
	local out rc
	out=$(selfcheck_lines); rc=$?
	printf '%s\n' "$out"
	printf '%s\n' "$out" | while IFS= read -r l; do append_log "$l"; done
	return $rc
}

watch_ppapi() {   # 后台跑：结论变化才写一行，最长 10 分钟
	local i prev="" now
	for i in $(nopre seq 1 120); do
		now=$(selfcheck_lines 2>/dev/null | nopre tail -1)
		if [ -n "$now" ] && [ "$now" != "$prev" ]; then
			append_log "$now"
			prev="$now"
		fi
		nopre sleep 5
	done
}

case "${1:-}" in
	--selfcheck-once) selfcheck_once; exit $? ;;
	--selfcheck)      echo "监控中，日志: $HWPROBE_LOG"; watch_ppapi; exit 0 ;;
esac

if [ -n "${HWPROBE_VTABLE:-}" ] && [ "${HWPROBE_VTABLE}" != 0 ]; then
	printf 'COM 虚表观测：已启用（每次接口方法调用都会记一行 vtable[槽位]）\n' >&2
else
	printf 'COM 虚表观测：未启用（要看编码器选择点就加 HWPROBE_VTABLE=1 重启 QQ）\n' >&2
fi

printf '日志: %s\n照着用：开一次屏幕共享（30 秒左右），结束后把日志发回来。\n' "$log" >&2

# 启动前先跑一次并把结论写进日志；之后每 5 秒复查（只读 /proc 与 pw-dump，不碰任何进程）
selfcheck_once >/dev/null
watch_ppapi &
printf '自检已启动：若收帧进程里没有探针，日志里会明确写出来（不用猜）\n' >&2

exec linuxqq-wayland-fix "$@"
